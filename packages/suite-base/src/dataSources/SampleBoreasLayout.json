    "comfort": {
      "name": "Ride comfort",
      "sourceCode": "// Ride comfort from the recorded accelerations: g-forces and a 0-100 score.\n// Output topics of user scripts can be plotted like any recorded topic.\nimport { Input } from \"./types\";\n\nexport const inputs = [\"/boreas/motion\"];\nexport const output = \"/studio_script/comfort\";\n\ntype Output = {\n  lateral_g: number;\n  longitudinal_g: number;\n  total_g: number;\n  comfort: number;\n};\n\nexport default function script(event: Input<\"/boreas/motion\">): Output {\n  const lateral = event.message.accel_lat / 9.81;\n  const longitudinal = event.message.accel_long / 9.81;\n  const total = Math.hypot(lateral, longitudinal);\n  // Around 0.3 g most passengers start to feel uncomfortable.\n  const comfort = Math.max(0, 100 - (total / 0.3) * 100);\n  return { lateral_g: lateral, longitudinal_g: longitudinal, total_g: total, comfort };\n}\n"
    }
  },
  "playbackConfig": {
    "speed": 1
