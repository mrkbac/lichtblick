# Cloudflare Plain Text Headers File
# Documentation: https://developers.cloudflare.com/pages/configuration/headers/

# Apply to all pages
/*
    X-Frame-Options: DENY
    X-Content-Type-Options: nosniff
    Referrer-Policy: origin
    Content-Security-Policy: base-uri 'self'
    Cross-Origin-Opener-Policy: same-origin
    Cross-Origin-Embedder-Policy: credentialless

# Build files with a content hash in their name never change: cache them for a year without
# revalidating, so unchanged chunks (Monaco, TypeScript, MapLibre, ...) survive deploys.
# Unhashed files keep Cloudflare's default (revalidate on every load).
/*.js
    Cache-Control: public, max-age=31536000, immutable
/*.mjs
    Cache-Control: public, max-age=31536000, immutable
/*.wasm
    Cache-Control: public, max-age=31536000, immutable
/*.woff2
    Cache-Control: public, max-age=31536000, immutable
/*.ttf
    Cache-Control: public, max-age=31536000, immutable

# The only unhashed scripts: the service worker and the scripts it imports must pick up new deploys
/sw.js
    ! Cache-Control
    Cache-Control: no-cache
/view-link-redirect.js
    ! Cache-Control
    Cache-Control: no-cache
/sw-worker-owners.js
    ! Cache-Control
    Cache-Control: no-cache
