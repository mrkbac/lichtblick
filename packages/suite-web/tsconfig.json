{
  "extends": "../../tsconfig.base.json",
  "include": ["**/*"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "es2025",
      "esnext.typedarrays",
      "webworker",
      "ESNext.Disposable"
    ],
    "noEmit": true,
    "experimentalDecorators": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@lichtblick/suite-base/*": ["../suite-base/src/*"]
    }
  }
}
