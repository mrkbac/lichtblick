{
  "extends": "@lichtblick/tsconfig/base",
  "include": ["./src/**/*", "./src/**/*.json", "../package.json"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "./src",
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "es2025",
      "esnext.typedarrays",
      "webworker",
      "ESNext.Disposable"
    ],
    "declarationMap": false,
    "sourceMap": false,
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false
  }
}
