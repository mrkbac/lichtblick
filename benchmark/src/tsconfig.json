{
  "extends": "@lichtblick/tsconfig/base",
  "include": ["./**/*"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "es2025",
      "esnext.typedarrays",
      "webworker",
      "ESNext.Disposable"
    ],
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@lichtblick/suite-base/*": ["../../packages/suite-base/src/*"]
    }
  }
}
