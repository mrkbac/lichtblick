{
  "manifest_version": 3,
  "name": "Digitalis proxy",
  "version": "1.2.0",
  "description": "Lets Digitalis reach ws:// and http:// servers that Chrome otherwise blocks as mixed content.",
  "minimum_chrome_version": "140",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://digitalis.marko.im/*", "https://licht.marko.im/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
