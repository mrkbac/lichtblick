{
  "manifest_version": 3,
  "name": "Licht WebSocket proxy",
  "version": "1.0.0",
  "description": "Lets https://licht.marko.im connect to ws:// servers that Chrome otherwise blocks as mixed content.",
  "minimum_chrome_version": "140",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://licht.marko.im/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
