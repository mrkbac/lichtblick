{
  "name": "lichtblick",
  "version": "1.30.0",
  "license": "MPL-2.0",
  "private": true,
  "productName": "Lichtblick",
  "description": "Core components of Lichtblick",
  "productDescription": "Lichtblick Suite",
  "packageManager": "pnpm@10.34.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/lichtblick-suite/lichtblick.git"
  },
  "author": {
    "name": "Lichtblick",
    "email": "lichtblick@bmwgroup.com"
  },
  "homepage": "https://github.com/lichtblick-suite",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "clean": "bash ci/clean-build.sh",
    "build:packages": "node ./node_modules/typescript7/bin/tsc --build --verbose packages/*/tsconfig.json packages/*/src/*/tsconfig.json",
    "desktop:build:dev": "rspack build --mode development --config desktop/rspack.config.ts",
    "desktop:build:prod": "rspack build --mode production --config desktop/rspack.config.ts",
    "desktop:serve": "rspack serve --mode development --config desktop/rspack.config.ts",
    "desktop:start": "electron desktop/.webpack",
    "web:build:dev": "rspack build --mode development --config web/rspack.config.ts",
    "web:build:prod": "rspack build --mode production --config web/rspack.config.ts",
    "web:serve": "rspack serve --mode development --config web/rspack.config.ts",
    "benchmark:serve": "rspack serve --mode development --config benchmark/rspack.config.ts",
    "benchmark:build:prod": "rspack build --mode production --config benchmark/rspack.config.ts",
    "benchmark:desktop:build:dev": "rspack build --mode development --config benchmark/rspack.desktop.config.ts",
    "benchmark:desktop:build:prod": "rspack build --mode production --config benchmark/rspack.desktop.config.ts",
    "benchmark:desktop:start": "electron benchmark/.webpack-desktop",
    "gen:organization-api": "openapi-typescript packages/suite-base/src/api/organization/openapi.yaml -o packages/suite-base/src/api/organization/schema.gen.ts && biome format --write packages/suite-base/src/api/organization/schema.gen.ts",
    "license-check": "node ci/license-check.ts",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:ci": "biome format --max-diagnostics=none .",
    "lint": "oxlint --report-unused-disable-directives --fix",
    "lint:ci": "oxlint --report-unused-disable-directives --max-warnings 0",
    "lint:ci:report": "oxlint --report-unused-disable-directives-severity error --quiet -f sarif > lint-report.sarif",
    "lint:knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:watch": "vitest",
    "test:e2e:web": "playwright test --config=e2e/tests/web/playwright.config.ts",
    "test:e2e:web:debug": "playwright test --config=e2e/tests/web/playwright.config.ts --debug",
    "test:e2e:web:report": "playwright show-report e2e/tests/web/reports",
    "test:e2e:web:ci": "CI=true playwright test --config=e2e/tests/web/playwright.config.ts",
    "test:e2e:web:smoke": "playwright test --config=e2e/tests/web/playwright.config.ts --grep @smoke",
    "test:e2e:web:smoke:ci": "CI=true playwright test --config=e2e/tests/web/playwright.config.ts --grep @smoke",
    "test:e2e:desktop": "playwright test --config=e2e/tests/desktop/playwright.config.ts",
    "test:e2e:desktop:debug": "playwright test --config=e2e/tests/desktop/playwright.config.ts --debug",
    "test:e2e:desktop:report": "playwright show-report e2e/reports/desktop",
    "test:e2e:desktop:ci": "CI=true playwright test --config=e2e/tests/desktop/playwright.config.ts",
    "test:e2e:desktop:smoke": "playwright test --config=e2e/tests/desktop/playwright.config.ts --grep @smoke",
    "test:e2e:desktop:smoke:ci": "CI=true playwright test --config=e2e/tests/desktop/playwright.config.ts --grep @smoke",
    "test:e2e:summary": "node e2e/ci-helpers/generate-test-summary.ts",
    "test:e2e:benchmark": "playwright test --config=benchmark/e2e/playwright.config.ts",
    "test:e2e:benchmark:debug": "playwright test --config=benchmark/e2e/playwright.config.ts --debug",
    "test:e2e:benchmark:report": "playwright show-report benchmark/e2e/reports",
    "test:e2e:benchmark:ci": "CI=true PLAYWRIGHT_JSON_OUTPUT_NAME=reports/results.json playwright test --config=benchmark/e2e/playwright.config.ts --reporter=list,json",
    "test:e2e:benchmark:summary": "node benchmark/e2e/ci-helpers/generate-benchmark-summary.ts",
    "package:win": "pnpm package --win",
    "package:darwin": "pnpm package --mac",
    "package:linux": "pnpm package --linux",
    "package": "electron-builder build --config desktop/electronBuilderConfig.js --publish never",
    "package:e2e": "pnpm install && pnpm clean && pnpm desktop:build:prod && pnpm package",
    "release:bump-nightly-version": "node ./ci/bump-nightly-version.ts",
    "storybook": "storybook dev --port 9009 --config-dir .storybook",
    "storybook:build": "storybook build --config-dir .storybook --stats-json",
    "typecheck": "node ./node_modules/typescript7/bin/tsc --build tsconfig.json web/src/tsconfig.json desktop/tsconfig.json desktop/*/tsconfig.json benchmark/tsconfig.json benchmark/src/tsconfig.json benchmark/desktop/*/tsconfig.json"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json}": [
      "oxlint --report-unused-disable-directives --no-error-on-unmatched-pattern --fix",
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@actions/exec": "1.1.1",
    "@biomejs/biome": "2.6.4",
    "@foxglove/ws-protocol": "0.8.0",
    "@lichtblick/tsconfig": "1.1.2",
    "@mui/material": "7.3.11",
    "@playwright/mcp": "0.0.84",
    "@playwright/test": "1.64.1",
    "@rsbuild/core": "2.3.0",
    "@rspack/cli": "2.3.0",
    "@rspack/core": "2.3.0",
    "@rspack/dev-server": "2.2.2",
    "@types/jsdom": "^30",
    "@types/license-checker": "^25.0.6",
    "@types/nearley": "2.11.5",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "eslint": "9.38.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-storybook": "10.6.5",
    "eslint-plugin-tss-unused-classes": "1.0.4",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "license-checker": "25.0.1",
    "lint-staged": "17.6.0",
    "nearley": "2.20.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "react-i18next": "17.1.11",
    "storybook": "10.6.5",
    "storybook-react-rsbuild": "3.6.1",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "ws": "8.22.1"
  }
}
