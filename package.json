{
  "name": "lichtblick",
  "version": "1.30.0",
  "license": "MPL-2.0",
  "private": true,
  "productName": "Lichtblick",
  "description": "Core components of Lichtblick",
  "productDescription": "Lichtblick Suite",
  "packageManager": "yarn@4.17.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lichtblick-suite/lichtblick.git"
  },
  "author": {
    "name": "Lichtblick",
    "email": "lichtblick@bmwgroup.com"
  },
  "homepage": "https://github.com/lichtblick-suite",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "clean": "bash ci/clean-build.sh",
    "build:packages": "node ./node_modules/typescript7/bin/tsc --build --verbose packages/*/tsconfig.json packages/*/src/*/tsconfig.json",
    "desktop:build:dev": "rspack build --mode development --config-loader jiti --config desktop/webpack.config.ts",
    "desktop:build:prod": "rspack build --mode production --config-loader jiti --config desktop/webpack.config.ts",
    "desktop:serve": "rspack serve --mode development --config-loader jiti --config desktop/webpack.config.ts",
    "desktop:serve:quicklook": "rspack serve --mode development --config-loader jiti --config desktop/webpack.quicklook.config.ts",
    "desktop:start": "electron desktop/.webpack",
    "web:build:dev": "rspack build --mode development --config-loader jiti --config web/webpack.config.ts",
    "web:build:prod": "rspack build --mode production --config-loader jiti --config web/webpack.config.ts",
    "web:serve": "rspack serve --mode development --config-loader jiti --config web/webpack.config.ts",
    "benchmark:serve": "rspack serve --mode development --config-loader jiti --config benchmark/webpack.config.ts",
    "benchmark:build:prod": "rspack build --mode production --config-loader jiti --config benchmark/webpack.config.ts",
    "benchmark:desktop:build:dev": "rspack build --mode development --config-loader jiti --config benchmark/webpack.desktop.config.ts",
    "benchmark:desktop:build:prod": "rspack build --mode production --config-loader jiti --config benchmark/webpack.desktop.config.ts",
    "benchmark:desktop:start": "electron benchmark/.webpack-desktop",
    "license-check": "ts-node ci/license-check.ts",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:ci": "biome format --max-diagnostics=none .",
    "lint": "TIMING=1 eslint --report-unused-disable-directives --cache --fix .",
    "lint:ci": "TIMING=1 eslint --report-unused-disable-directives --cache --max-warnings 0 --config eslint.config.ci.mjs .",
    "lint:ci:report": "yarn lint:ci -f json -o eslint-report.json --quiet",
    "lint:unused-exports": "ts-node ./ci/lint-unused-exports.ts",
    "lint:dependencies": "ts-node ./ci/lint-dependencies.ts .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:watch": "vitest",
    "test:e2e:web": "playwright test --config=e2e/tests/web/playwright.config.ts",
    "test:e2e:web:debug": "playwright test --config=e2e/tests/web/playwright.config.ts --debug",
    "test:e2e:web:report": "playwright show-report e2e/tests/web/reports",
    "test:e2e:web:ci": "CI=true playwright test --config=e2e/tests/web/playwright.config.ts",
    "test:e2e:web:smoke": "playwright test --config=e2e/tests/web/playwright.config.ts --grep @smoke",
    "test:e2e:web:smoke:ci": "CI=true playwright test --config=e2e/tests/web/playwright.config.ts --grep @smoke",
    "test:e2e:desktop": "playwright test --config=e2e/tests/desktop/playwright.config.ts",
    "test:e2e:desktop:debug": "playwright test --config=e2e/tests/desktop/playwright.config.ts --debug",
    "test:e2e:desktop:report": "playwright show-report e2e/reports/desktop",
    "test:e2e:desktop:ci": "CI=true playwright test --config=e2e/tests/desktop/playwright.config.ts",
    "test:e2e:desktop:smoke": "playwright test --config=e2e/tests/desktop/playwright.config.ts --grep @smoke",
    "test:e2e:desktop:smoke:ci": "CI=true playwright test --config=e2e/tests/desktop/playwright.config.ts --grep @smoke",
    "test:e2e:summary": "ts-node e2e/ci-helpers/generate-test-summary.ts",
    "test:e2e:benchmark": "playwright test --config=benchmark/e2e/playwright.config.ts",
    "test:e2e:benchmark:debug": "playwright test --config=benchmark/e2e/playwright.config.ts --debug",
    "test:e2e:benchmark:report": "playwright show-report benchmark/e2e/reports",
    "test:e2e:benchmark:ci": "CI=true PLAYWRIGHT_JSON_OUTPUT_NAME=reports/results.json playwright test --config=benchmark/e2e/playwright.config.ts --reporter=list,json",
    "test:e2e:benchmark:summary": "ts-node benchmark/e2e/ci-helpers/generate-benchmark-summary.ts",
    "package:win": "yarn package --win",
    "package:darwin": "yarn package --mac",
    "package:linux": "yarn package --linux",
    "package": "cross-env NODE_OPTIONS='-r ts-node/register' electron-builder build --config desktop/electronBuilderConfig.js --publish never",
    "package:e2e": "yarn && yarn clean && yarn desktop:build:prod && yarn package",
    "release:bump-nightly-version": "node -r ts-node/register ./ci/bump-nightly-version.ts",
    "storybook": "storybook dev --port 9009 --config-dir .storybook",
    "storybook:build": "storybook build --config-dir .storybook --stats-json",
    "version:all": "yarn workspaces foreach version",
    "typecheck": "node ./node_modules/typescript7/bin/tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json}": [
      "eslint --report-unused-disable-directives --fix --cache",
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "workspaces": {
    "packages": [
      "desktop",
      "packages/*",
      "packages/@types/*",
      "web",
      "benchmark"
    ]
  },
  "resolutions": {
    "@types/node": "26.6.6",
    "react-dnd": "patch:react-dnd@npm:16.0.1#./patches/react-dnd.patch",
    "@types/react": "19.3.0",
    "esbuild": "0.28.1",
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "js-cookie": "3.0.7",
    "qs": "6.15.2",
    "ws@^8.18.0": "8.21.0",
    "tar": "7.5.22",
    "undici": "6.29.1",
    "brace-expansion@^2.0.1": "2.1.7",
    "brace-expansion@^2.0.2": "2.1.7",
    "brace-expansion@^5.0.5": "5.0.12",
    "compression": "1.8.2",
    "http-cache-semantics": "4.3.0",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "webpack-dev-middleware@^6.1.2": "7.4.5",
    "flatted": "3.4.2",
    "@xmldom/xmldom": "0.9.12",
    "uuid": "14.0.0",
    "svgo": "3.3.5",
    "browserslist": "4.28.9",
    "fast-uri": "3.1.7",
    "plist@3.1.0": "patch:plist@npm%3A3.1.0#./patches/plist-npm-3.1.0-66799cb2cb.patch",
    "plist@^3.0.4": "patch:plist@npm%3A3.1.0#./patches/plist-npm-3.1.0-66799cb2cb.patch",
    "plist@^3.0.5": "patch:plist@npm%3A3.1.0#./patches/plist-npm-3.1.0-66799cb2cb.patch",
    "plist@^3.1.0": "patch:plist@npm%3A3.1.0#./patches/plist-npm-3.1.0-66799cb2cb.patch"
  },
  "devDependencies": {
    "@actions/core": "1.11.1",
    "@actions/exec": "1.1.1",
    "@actions/tool-cache": "2.0.2",
    "@biomejs/biome": "2.6.4",
    "@eslint/compat": "2.1.1",
    "@lichtblick/eslint-plugin": "2.0.8",
    "@lichtblick/eslint-plugin-suite": "workspace:*",
    "@lichtblick/tsconfig": "1.1.2",
    "@mui/material": "7.3.11",
    "@octokit/rest": "22.0.1",
    "@playwright/mcp": "0.0.84",
    "@playwright/test": "1.64.1",
    "@rsbuild/core": "2.3.0",
    "@rspack/cli": "2.3.0",
    "@rspack/core": "2.3.0",
    "@rspack/dev-server": "2.2.2",
    "@types/case-sensitive-paths-webpack-plugin": "2.1.9",
    "@types/license-checker": "^25.0.6",
    "@types/node": "26.6.6",
    "@types/react-refresh": "^0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "@typescript-eslint/rule-tester": "8.62.1",
    "@typescript-eslint/utils": "8.62.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "assert": "2.1.0",
    "cross-env": "10.1.0",
    "depcheck": "1.4.7",
    "electron": "44.4.5",
    "electron-builder": "26.18.0",
    "eslint": "9.38.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-import-resolver-webpack": "0.13.11",
    "eslint-plugin-es": "4.1.0",
    "eslint-plugin-file-progress": "1.4.0",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-storybook": "10.6.5",
    "eslint-plugin-tss-unused-classes": "1.0.4",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "license-checker": "25.0.1",
    "lint-staged": "17.6.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "react-refresh": "0.18.0",
    "rimraf": "6.1.3",
    "semver": "7.8.5",
    "storybook": "10.6.5",
    "storybook-react-rsbuild": "3.6.1",
    "ts-node": "10.9.2",
    "ts-unused-exports": "11.0.1",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@foxglove/omgidl-parser": "1.2.2",
    "@foxglove/omgidl-serialization": "1.2.5",
    "@foxglove/ros2idl-parser": "0.3.6",
    "@lichtblick/hooks": "workspace:*",
    "@lichtblick/log": "workspace:*",
    "@lichtblick/suite": "workspace:*",
    "react-use": "17.6.1",
    "rehype-raw": "7.0.0"
  }
}
